#!/bin/bash
# optimize-services.chroot — Low-RAM / fast-boot optimization.
#
# Philosophy (see spec §20-26):
#   - Essential desktop services stay ENABLED: NetworkManager, PipeWire,
#     WirePlumber, Bluetooth, ZRAM, LightDM, Xfce.
#   - Optional services (CUPS, Avahi, ModemManager, PackageKit) stay
#     INSTALLED but are DISABLED so they do not waste RAM at boot. They can be
#     re-enabled any time on the live system:
#       sudo systemctl enable --now <unit>
#   - Nothing is unmasked or force-removed by this hook; packages remain, so
#     apt/dpkg dependency relations stay intact.
#
# Bluetooth is intentionally NOT touched: bluetooth.service must run.
# Picom is started per-user at login via /etc/xdg/autostart/picom.desktop,
# so no picom disable override is written here.
set -e

DISABLED="
  cups.service
  cups.socket
  avahi-daemon.service
  avahi-daemon.socket
  ModemManager.service
  packagekit.service
  packagekit-offline-update.service
"

for unit in $DISABLED; do
  if [ -e "/usr/lib/systemd/system/$unit" ] || [ -e "/etc/systemd/system/$unit" ]; then
    systemctl disable "$unit" 2>/dev/null || true
    echo "INFO: disabled systemd unit (available, not auto-started): $unit"
  fi
done

# Get back to a sane, quiet system state
echo "INFO: optional services disabled; Bluetooth/PipeWire/NetworkManager/ZRAM untouched"