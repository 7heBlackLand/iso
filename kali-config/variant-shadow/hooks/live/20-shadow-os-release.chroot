#!/bin/sh

# Shadow os-release hook
#
# Generates /etc/os-release and friends for the Shadow GNU/Linux Rolling
# distribution. Build-time version/build variables are expanded here at
# build time, so no placeholder is left unresolved in the shipped file.

set -e

BUILD_ID="$(date +%Y%m%d)"
BUILD_ARCH="$(dpkg --print-architecture 2>/dev/null || echo unknown)"

cat > /etc/os-release << EOF
PRETTY_NAME="Shadow GNU/Linux Rolling"
NAME="Shadow GNU/Linux"
ID=Shadow
ID_LIKE=debian
VERSION_ID="rolling"
VERSION="Rolling"
VERSION_CODENAME=Shadow-rolling
BUILD_ID=$BUILD_ID
BUILD_ARCH=$BUILD_ARCH
EOF

cat > /etc/lsb-release << EOF
DISTRIB_ID=Shadow
DISTRIB_RELEASE=rolling
DISTRIB_CODENAME=Shadow-rolling
DISTRIB_DESCRIPTION="Shadow GNU/Linux Rolling"
EOF

cat > /etc/shadow-version << EOF
Shadow GNU/Linux Rolling - build $BUILD_ID ($BUILD_ARCH)
EOF

chmod 644 /etc/os-release /etc/lsb-release /etc/shadow-version

exit 0