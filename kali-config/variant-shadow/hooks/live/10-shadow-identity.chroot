#!/bin/sh

# Shadow identity hook
#
# Configures the shadow@egypt identity on the live system.
# The live-config values in /etc/live/config.conf.d/shadow.conf are the
# authoritative source at boot time; this hook guarantees the identity is
# also present in the built image.

set -e

# --- Hostname ---------------------------------------------------------------
echo "egypt" > /etc/hostname

cat > /etc/hosts << 'EOF'
127.0.0.1       localhost
127.0.1.1       egypt

# The following lines are desirable for IPv6 capable hosts
::1     localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

# --- User -------------------------------------------------------------------
# Create the shadow user if it does not already exist. useradd -m populates
# the home directory from /etc/skel (our user configuration includes).
if ! grep -q '^shadow:' /etc/passwd; then
  useradd -m -s /bin/zsh -c "Shadow" shadow
fi

echo "shadow:shadow" | chpasswd

# Groups: sudo + standard console/media groups
usermod -aG sudo,cdrom,floppy,audio,video,plugdev,netdev shadow

# NOPASSWD sudo for the live user (typical for live systems)
cat > /etc/sudoers.d/shadow << 'EOF'
shadow ALL=(ALL) NOPASSWD:ALL
EOF
chmod 440 /etc/sudoers.d/shadow

# --- Root shell ------------------------------------------------------------
# Zsh is the preferred interactive shell for both user and root.
if command -v zsh >/dev/null 2>&1; then
  chsh -s /bin/zsh root 2>/dev/null || true
fi

# --- Ownership --------------------------------------------------------------
if [ -d /home/shadow ]; then
  chown -R shadow:shadow /home/shadow
fi

exit 0